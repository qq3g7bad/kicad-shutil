	done

	# Validate operation
	if [[ -z "$operation" ]]; then
		error "No operation specified"
		usage_pcb 2
	fi

	# Validate input file
	if [[ -z "$input_file" ]]; then
		error "No input file specified"
		usage_pcb 2
	fi

	if [[ ! -f "$input_file" ]]; then
		error "Input file not found: $input_file"
		exit 1
	fi

	# Initialize
	if ! init_utils; then
		exit 1
	fi
	mkdir -p "$CACHE_DIR"

	# Route to operation
	case "$operation" in
		gerber-output)
			source "$LIB_DIR/pcb_export.sh"
			export_gerber_output "$input_file" "$output_dir"
			;;
		verify)
			cmd_pcb_verify "$input_file" \
				"$opt_expected_width" \
				"$opt_expected_text_size" \
				"$opt_expected_text_thickness"
			;;
		*)
			error "Unknown operation: $operation"
			echo "" >&2
			usage_pcb 2
			;;
	esac
}

# @IMPL-MAIN-008@ (FROM: @ARCH-VERIFY-001@, @ARCH-PCB-001@)
# pcb verify - check silkscreen uniformity of a board.
# Accepts .kicad_pcb directly, or .kicad_pro/.kicad_sch (derives the
# sibling .kicad_pcb). The whole board is one set: board-level gr_*
# graphics and every placed footprint's fp_* silk are checked together.
cmd_pcb_verify() {
	local input_file="$1"
	local exp_w="$2"
	local exp_ts="$3"
	local exp_tt="$4"

	# Resolve to a .kicad_pcb file (lightweight; no netlist concerns)
	local pcb_file=""
	case "$(basename "$input_file")" in
		*.kicad_pcb)
			pcb_file="$input_file"
			;;
		*.kicad_pro)
			pcb_file="${input_file%.kicad_pro}.kicad_pcb"
			;;
		*.kicad_sch)
			pcb_file="${input_file%.kicad_sch}.kicad_pcb"
			;;
		*)
			error "Unsupported file type: $input_file"
			error "Supported types: .kicad_pcb, .kicad_pro, .kicad_sch"
			exit 1
			;;
	esac

	if [[ ! -f "$pcb_file" ]]; then
		error "PCB file not found: $pcb_file"
		exit 1
	fi

	export SILK_EXPECTED_WIDTH="$exp_w"
	export SILK_EXPECTED_TEXT_SIZE="$exp_ts"
	export SILK_EXPECTED_TEXT_THICKNESS="$exp_tt"

	source "$LIB_DIR/verify_silk.sh"
	init_silk_stats

	info "kicad-shutil - Checking board silkscreen uniformity: $(basename "$pcb_file")"

	verify_silk_file "$pcb_file" "$(basename "$pcb_file")"

	local rc=0
	evaluate_silk_set || rc=1

	if [[ "${VERBOSE:-false}" == "true" ]]; then
		print_silk_summary
	fi

	if [[ $rc -ne 0 ]]; then
		exit 1
	fi
	info "Silkscreen verification complete"
}

# Run main
main "$@"
