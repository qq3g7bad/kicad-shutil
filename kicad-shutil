# PCB command implementation
cmd_pcb() {
	local operation=""
	local output_dir=""
	local input_file=""
	local opt_expected_width=""
	local opt_expected_text_size=""
	local opt_expected_text_thickness=""

	# Parse arguments
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-h | --help)
				usage_pcb
				;;
			--verbose)
				export VERBOSE=true
				shift
				;;
			--output)
				output_dir="$2"
				shift 2
				;;
			--expected-width)
				opt_expected_width="$2"
				shift 2
				;;
			--expected-text-size)
				opt_expected_text_size="$2"
				shift 2
				;;
			--expected-text-thickness)
				opt_expected_text_thickness="$2"
				shift 2
				;;
			-*)
				error "Unknown option for 'pcb' command: $1"
				echo "" >&2
				usage_pcb 2
				;;
			*)
				if [[ -z "$operation" ]]; then
					operation="$1"
