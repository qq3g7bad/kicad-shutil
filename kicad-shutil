#!/usr/bin/env bash

# @IMPL-MAIN-001@ (FROM: @ARCH-MAIN-001@)
# kicad-shutil - KiCad Project Helper Utilities
# Manage KiCad projects: verify libraries, symbols, footprints, and datasheets

set -euo pipefail

# Handle Ctrl-C to stop all tasks immediately
trap 'echo "" >&2; echo "Interrupted by user" >&2; exit 130' INT TERM

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"
CACHE_DIR="$SCRIPT_DIR/cache"

# Verbose mode (set via --verbose flag)
export VERBOSE=false

# Deep verification mode (set via --deep flag)
export DEEP=false

# Source library modules
source "$LIB_DIR/utils.sh"

# Usage information
usage() {
	cat <<EOF
${COLOR_BOLD}kicad-shutil${COLOR_RESET} - KiCad Project Helper Utilities

${COLOR_BOLD}USAGE${COLOR_RESET}
  kicad-shutil <command> [flags]

${COLOR_BOLD}CORE COMMANDS${COLOR_RESET}
  ${COLOR_BOLD}project${COLOR_RESET}    Verify KiCad project and all libraries
  ${COLOR_BOLD}sym${COLOR_RESET}        Manage symbol library files (.kicad_sym)
  ${COLOR_BOLD}pcb${COLOR_RESET}        Generate PCB manufacturing output files

${COLOR_BOLD}FLAGS${COLOR_RESET}
  ${COLOR_CYAN}--verbose${COLOR_RESET}         Show detailed verbose output
  ${COLOR_CYAN}-h, --help${COLOR_RESET}        Show help for command
  ${COLOR_CYAN}-v, --version${COLOR_RESET}     Show version information

${COLOR_BOLD}EXAMPLES${COLOR_RESET}
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil project my_project.kicad_pro
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil my_project.kicad_pro
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil sym --update-digikey pmic.kicad_sym
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil pcb gerber-output my_board.kicad_pcb

${COLOR_GRAY}Use 'kicad-shutil <command> --help' for more information about a command.${COLOR_RESET}
EOF
	exit 0
}

# Project command: verify a KiCad project
# Usage: usage_project [exit_code]
usage_project() {
	local exit_code="${1:-0}"
	cat <<EOF
${COLOR_BOLD}kicad-shutil project${COLOR_RESET} - Verify KiCad project and all libraries

${COLOR_BOLD}USAGE${COLOR_RESET}
  kicad-shutil project [flags] <directory|file.kicad_pro>
  kicad-shutil <file.kicad_pro>  ${COLOR_GRAY}(implicit project command)${COLOR_RESET}

${COLOR_BOLD}DESCRIPTION${COLOR_RESET}
  Performs comprehensive verification of a KiCad project:
    ${COLOR_GREEN}•${COLOR_RESET} Validates project structure and library tables
    ${COLOR_GREEN}•${COLOR_RESET} Checks all symbol libraries for missing footprints and datasheets
    ${COLOR_GREEN}•${COLOR_RESET} Checks all footprint libraries for missing 3D models
    ${COLOR_GREEN}•${COLOR_RESET} Resolves all environment variables (KIPRJMOD, etc.)

${COLOR_BOLD}FLAGS${COLOR_RESET}
  ${COLOR_CYAN}--verbose${COLOR_RESET}    Show detailed verbose output (INFO, OK, and summary)
  ${COLOR_CYAN}--deep${COLOR_RESET}       Enable deep verification (datasheet URL validation)
  ${COLOR_CYAN}-h, --help${COLOR_RESET}   Show help for command

${COLOR_BOLD}EXAMPLES${COLOR_RESET}
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil project my_project.kicad_pro
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil my_project.kicad_pro
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil project ./my_project
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil --verbose project my_project.kicad_pro

EOF
	exit "$exit_code"
}

# Symbol command: manage symbol library files
# Usage: usage_sym [exit_code]
usage_sym() {
	local exit_code="${1:-0}"
	cat <<EOF
${COLOR_BOLD}kicad-shutil sym${COLOR_RESET} - Manage KiCad symbol library files

${COLOR_BOLD}USAGE${COLOR_RESET}
  kicad-shutil sym [flags] <file.kicad_sym> [<file2.kicad_sym> ...]

${COLOR_BOLD}DESCRIPTION${COLOR_RESET}
  Manage KiCad symbol library files (.kicad_sym).
  If no operation flag is specified, defaults to ${COLOR_CYAN}--verify${COLOR_RESET}.

${COLOR_BOLD}FLAGS${COLOR_RESET}
  ${COLOR_CYAN}-v, --verify${COLOR_RESET}               Validate footprints, datasheets, and show report
  ${COLOR_CYAN}-u, --update-digikey${COLOR_RESET}       Add/update DigiKey part numbers and metadata
  ${COLOR_CYAN}-d, --delete-digikey${COLOR_RESET}       Remove all DigiKey metadata from symbols
  ${COLOR_CYAN}-D, --download-datasheets${COLOR_RESET}  Download all datasheets
  ${COLOR_CYAN}-t, --to${COLOR_RESET} <dir>             Target directory for datasheet downloads
  ${COLOR_CYAN}-h, --help${COLOR_RESET}                 Show help for command

${COLOR_BOLD}EXAMPLES${COLOR_RESET}
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil sym pmic.kicad_sym
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil sym --verify pmic.kicad_sym
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil sym --update-digikey pmic.kicad_sym
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil sym --delete-digikey pmic.kicad_sym
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil sym --download-datasheets *.kicad_sym --to ~/datasheets

EOF
	exit "$exit_code"
}

# PCB command: generate manufacturing output
# Usage: usage_pcb [exit_code]
usage_pcb() {
	local exit_code="${1:-0}"
	cat <<EOF
${COLOR_BOLD}kicad-shutil pcb${COLOR_RESET} - Generate PCB manufacturing output files

${COLOR_BOLD}USAGE${COLOR_RESET}
  kicad-shutil pcb <operation> [flags] <file>

${COLOR_BOLD}OPERATIONS${COLOR_RESET}
  ${COLOR_BOLD}gerber-output${COLOR_RESET}  Generate all manufacturing files (Gerbers, drill, position, netlist)

${COLOR_BOLD}FLAGS${COLOR_RESET}
  ${COLOR_CYAN}--output${COLOR_RESET} <dir>  Output directory ${COLOR_GRAY}(default: ./manufacturing/)${COLOR_RESET}
  ${COLOR_CYAN}--verbose${COLOR_RESET}       Show detailed verbose output
  ${COLOR_CYAN}-h, --help${COLOR_RESET}      Show help for command

${COLOR_BOLD}SUPPORTED INPUT FILES${COLOR_RESET}
  ${COLOR_BOLD}.kicad_pcb${COLOR_RESET}    PCB file (looks for matching .kicad_sch for netlist)
  ${COLOR_BOLD}.kicad_pro${COLOR_RESET}    Project file (auto-detects PCB and schematic)
  ${COLOR_BOLD}.kicad_sch${COLOR_RESET}    Schematic file (looks for matching .kicad_pcb)

${COLOR_BOLD}OUTPUT STRUCTURE${COLOR_RESET}
  manufacturing/
  ├── gerbers/   All Gerber layers
  ├── drill/     Drill files (Excellon format)
  ├── position/  Position files (front.pos, back.pos)
  └── netlist/   Netlist file (KiCad XML)

${COLOR_BOLD}EXAMPLES${COLOR_RESET}
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil pcb gerber-output my_board.kicad_pcb
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil pcb gerber-output my_project.kicad_pro
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil pcb gerber-output my_board.kicad_pcb --output /tmp/fab
  ${COLOR_GRAY}\$${COLOR_RESET} kicad-shutil --verbose pcb gerber-output my_board.kicad_pcb

${COLOR_BOLD}REQUIREMENTS${COLOR_RESET}
  ${COLOR_YELLOW}kicad-cli${COLOR_RESET} (KiCad 7.0 or later) must be installed and available in PATH

EOF
	exit "$exit_code"
}

# @IMPL-MAIN-002@ (FROM: @ARCH-MAIN-001@)
# Parse command line and route to appropriate subcommand
main() {
	if [[ $# -eq 0 ]]; then
		usage
	fi

	local command="$1"

	# Handle special cases
	case "$command" in
		-h | --help | help)
			usage
			;;
		-v | --version)
			echo "kicad-shutil"
			exit 0
			;;
		--verbose)
			# Global verbose flag
			export VERBOSE=true
			shift
			main "$@"
			return $?
			;;
		project)
			# Explicit project subcommand
			shift
			cmd_project "$@"
			return $?
			;;
		sym)
			# Symbol library management
			shift
			cmd_sym "$@"
			return $?
			;;
		pcb)
			# PCB manufacturing output
			shift
			cmd_pcb "$@"
			return $?
			;;
		*.kicad_pro)
			# Implicit project command (auto-detect .kicad_pro files)
			cmd_project "$@"
			return $?
			;;
		*)
			error "Unknown command or option: $command"
			echo "" >&2
			echo "Use 'kicad-shutil --help' for usage information." >&2
			exit 2
			;;
	esac
}

# @IMPL-MAIN-003@ (FROM: @ARCH-MAIN-001@)
# Project command implementation
cmd_project() {
	local project_input=""
	local project_file=""

	# Parse arguments
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-h | --help)
				usage_project
				;;
			--verbose)
				export VERBOSE=true
				shift
				;;
			--deep)
				export DEEP=true
				shift
				;;
			-*)
				error "Unknown option for 'project' command: $1"
				echo "" >&2
				usage_project 2
				;;
			*)
				if [[ -z "$project_input" ]]; then
					project_input="$1"
				else
					error "Only one project path can be specified"
					exit 2
				fi
				shift
				;;
		esac
	done

	# Validate input
	if [[ -z "$project_input" ]]; then
		error "No project path specified"
		usage_project 2
	fi

	# Determine project file
	if [[ -d "$project_input" ]]; then
		# Input is a directory - find .kicad_pro file
		local pro_files=("$project_input"/*.kicad_pro)
		if [[ ${#pro_files[@]} -eq 0 || ! -f "${pro_files[0]}" ]]; then
			error "No .kicad_pro file found in directory: $project_input"
			exit 1
		fi
		if [[ ${#pro_files[@]} -gt 1 ]]; then
			error "Multiple .kicad_pro files found in directory: $project_input"
			echo "Please specify the project file directly" >&2
			exit 1
		fi
		project_file="${pro_files[0]}"
	elif [[ -f "$project_input" ]]; then
		# Input is a file
		if [[ ! "$project_input" =~ \.kicad_pro$ ]]; then
			error "File must be a .kicad_pro file: $project_input"
			exit 1
		fi
		project_file="$project_input"
	else
		error "Path not found: $project_input"
		exit 1
	fi

	# Initialize
	if ! init_utils; then
		exit 1
	fi
	mkdir -p "$CACHE_DIR"

	# Source verification modules
	source "$LIB_DIR/verify.sh"

	# Verify project
	verify_file "$project_file" ""
}

# @IMPL-MAIN-004@ (FROM: @ARCH-MAIN-001@)
# Symbol command implementation
cmd_sym() {
	# Source required modules
	source "$LIB_DIR/parser.sh"
	source "$LIB_DIR/writer.sh"

	local OPT_UPDATE_DIGIKEY=false
	local OPT_DELETE_DIGIKEY=false
	local OPT_VERIFY=false
	local OPT_DOWNLOAD_DATASHEETS=false
	local DATASHEET_DIR="./datasheets"
	local FILES=()

	# Parse arguments
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-h | --help)
				usage_sym
				;;
			-u | --update-digikey)
				OPT_UPDATE_DIGIKEY=true
				shift
				;;
			-d | --delete-digikey)
				OPT_DELETE_DIGIKEY=true
				shift
				;;
			-v | --verify)
				OPT_VERIFY=true
				shift
				;;
			-D | --download-datasheets)
				OPT_DOWNLOAD_DATASHEETS=true
				shift
				;;
			-t | --to)
				DATASHEET_DIR="$2"
				shift 2
				;;
			-*)
				error "Unknown option: $1"
				usage_sym 2
				;;
			*)
				FILES+=("$1")
				shift
				;;
		esac
	done

	# Validate: at least one file
	if [[ ${#FILES[@]} -eq 0 ]]; then
		error "No input files specified"
		usage_sym 2
	fi

	# If no operation specified, default to --verify
	if ! $OPT_UPDATE_DIGIKEY && ! $OPT_DELETE_DIGIKEY && ! $OPT_VERIFY && ! $OPT_DOWNLOAD_DATASHEETS; then
		info "No operation specified, defaulting to --verify"
		OPT_VERIFY=true
	fi

	# Validate: can't use both update and delete at the same time
	if $OPT_UPDATE_DIGIKEY && $OPT_DELETE_DIGIKEY; then
		error "Cannot use --update-digikey and --delete-digikey together"
		exit 1
	fi

	# Expand glob patterns and validate files
	local expanded_files=()
	for pattern in "${FILES[@]}"; do
		if [[ -f "$pattern" ]]; then
			expanded_files+=("$pattern")
		else
			# Try glob expansion
			# shellcheck disable=SC2206
			local matches=($pattern)
			if [[ -e "${matches[0]}" ]]; then
				expanded_files+=("${matches[@]}")
			else
				warn "File not found: $pattern"
			fi
		fi
	done

	FILES=("${expanded_files[@]}")

	if [[ ${#FILES[@]} -eq 0 ]]; then
		error "No valid input files found"
		exit 1
	fi

	# Validate file extensions (only .kicad_sym allowed)
	for file in "${FILES[@]}"; do
		if [[ ! "$file" =~ \.kicad_sym$ ]]; then
			error "Unsupported file type: $file (only .kicad_sym files are supported)"
			exit 1
		fi
	done

	# Initialize
	if ! init_utils; then
		exit 1
	fi
	mkdir -p "$CACHE_DIR"

	# Initialize verify if needed
	if $OPT_VERIFY; then
		source "$LIB_DIR/verify.sh"
		init_verify_stats
	fi

	# Initialize datasheet if needed
	if $OPT_DOWNLOAD_DATASHEETS; then
		source "$LIB_DIR/datasheet.sh"
		init_datasheet_stats
		export DATASHEET_DIR
	fi

	# Initialize DigiKey if needed
	if $OPT_UPDATE_DIGIKEY || $OPT_DELETE_DIGIKEY; then
		source "$LIB_DIR/digikey.sh"
	fi

	info "kicad-shutil - Processing ${#FILES[@]} file(s)"

	# Process each file
	for file in "${FILES[@]}"; do
		if [[ ! -f "$file" ]]; then
			warn "Skipping non-existent file: $file"
			continue
		fi

		process_symbol_file "$file"
	done

	# Print verification report at the end (only in verbose mode)
	if $OPT_VERIFY && [[ "${VERBOSE:-false}" == "true" ]]; then
		print_verify_report
	fi

	# Print datasheet download summary (only in verbose mode)
	if $OPT_DOWNLOAD_DATASHEETS && [[ "${VERBOSE:-false}" == "true" ]]; then
		print_datasheet_summary
	fi

	info "Processing complete"
}

# @IMPL-MAIN-005@ (FROM: @ARCH-MAIN-001@)
# Process a single .kicad_sym file
process_symbol_file() {
	local file="$1"
	local filename
	filename=$(basename "$file")
	local category="${filename%.kicad_sym}"

	# Don't print info messages in TSV mode
	if [[ "${OUTPUT_TSV:-false}" != "true" ]]; then
		info "Processing: $filename"
	fi

	# Parse all symbols in the file
	local symbols_data
	symbols_data=$(parse_file "$file")

	if [[ -z "$symbols_data" ]]; then
		if [[ "${OUTPUT_TSV:-false}" != "true" ]]; then
			warn "  No symbols found in $filename"
		fi
		return
	fi

	# Count symbols
	local symbol_count
	symbol_count=$(echo "$symbols_data" | grep -c "^SYMBOL|" || true)
	if [[ "${OUTPUT_TSV:-false}" != "true" ]]; then
		info "  Found $symbol_count symbol(s)"
	fi

	# Process based on options
	if $OPT_VERIFY; then
		verify_file "$file" "$symbols_data"
	fi

	if $OPT_DOWNLOAD_DATASHEETS; then
		download_datasheets "$file" "$symbols_data" "$category"
	fi

	if $OPT_UPDATE_DIGIKEY; then
		process_digikey "$file" "$symbols_data"
	fi

	if $OPT_DELETE_DIGIKEY; then
		delete_digikey_info "$file" "$symbols_data"
	fi
}

# @IMPL-MAIN-006@ (FROM: @ARCH-MAIN-001@, @ARCH-PCB-001@)
# PCB command implementation
cmd_pcb() {
	local operation=""
	local output_dir=""
	local input_file=""

	# Parse arguments
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-h | --help)
				usage_pcb
				;;
			--verbose)
				export VERBOSE=true
				shift
				;;
			--output)
				output_dir="$2"
				shift 2
				;;
			-*)
				error "Unknown option for 'pcb' command: $1"
				echo "" >&2
				usage_pcb 2
				;;
			*)
				if [[ -z "$operation" ]]; then
					operation="$1"
				elif [[ -z "$input_file" ]]; then
					input_file="$1"
				else
					error "Too many arguments"
					echo "" >&2
					usage_pcb 2
				fi
				shift
				;;
		esac
	done

	# Validate operation
	if [[ -z "$operation" ]]; then
		error "No operation specified"
		usage_pcb 2
	fi

	# Validate input file
	if [[ -z "$input_file" ]]; then
		error "No input file specified"
		usage_pcb 2
	fi

	if [[ ! -f "$input_file" ]]; then
		error "Input file not found: $input_file"
		exit 1
	fi

	# Initialize
	if ! init_utils; then
		exit 1
	fi
	mkdir -p "$CACHE_DIR"

	# Source PCB export module
	source "$LIB_DIR/pcb_export.sh"

	# Route to operation
	case "$operation" in
		gerber-output)
			export_gerber_output "$input_file" "$output_dir"
			;;
		*)
			error "Unknown operation: $operation"
			echo "" >&2
			usage_pcb 2
			;;
	esac
}

# Run main
main "$@"
